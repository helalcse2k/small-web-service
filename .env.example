# Copy this file to .env and fill in your real values (never commit .env!)
# cp .env.example .env

# ── Application & Docker Compose ──────────────────────────────────────────────
PORT=8080
LOG_LEVEL=info
ENV_NAME=local
APP_VERSION=1.0.0

# ── Observability (Grafana) ───────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-password

# ── Terraform (loaded via: set -a && source ../.env && set +a) ────────────────
TF_VAR_aws_region=us-east-1
TF_VAR_environment=staging
TF_VAR_instance_type=t3.large
TF_VAR_key_name=devops-task-key
TF_VAR_log_retention_days=7
TF_VAR_ecr_repository=YOUR_ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/devops-task-service
TF_VAR_app_version=latest
